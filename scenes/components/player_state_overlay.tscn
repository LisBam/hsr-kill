[ext_resource type="Script" path="res://scripts/ui/player_state_overlay.gd" id="1_script"]

[sub_resource type="Shader" id="ShaderDeathGrayscale"]
code = "shader_type canvas_item;\n\nuniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_nearest;\n\nvoid fragment() {\n\tvec4 sampled_color = textureLod(screen_texture, SCREEN_UV, 0.0);\n\tfloat luminance = dot(sampled_color.rgb, vec3(0.299, 0.587, 0.114));\n\tCOLOR = vec4(vec3(luminance) * 0.62, sampled_color.a);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterialDeathGrayscale"]
